{
  "name": "yiyeqingzhou-studio",
  "version": "1.0.0",
  "description": "一叶轻舟工作室 — AI 小说创作桌面应用",
  "main": "electron-app/main.mjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server/index.ts\"",
    "dev:server": "tsx server/index.ts",
    "dev:frontend": "vite",
    "dev:electron": "concurrently \"vite\" \"tsx server/index.ts\" \"wait-on http://localhost:3001 && electron .\"",
    "build": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:dist": "npm run build && npm run build:server && electron-builder --win",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.424.0",
    "pdfkit": "^0.19.1",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sql.js": "^1.11.0",
    "tailwindcss": "^3.4.10",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "nw": "^0.114.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.yiyeqingzhou.studio",
    "productName": "一叶轻舟工作室",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron-app/**/*",
      "templates/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "一叶轻舟工作室",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
