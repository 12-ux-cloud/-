{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist-server",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": [
    "server/**/*.ts",
    "electron/shared/**/*.ts",
    "electron/agents/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-server", "src"]
}
